{
  "scope": "Declared reconstruction ablation: excludes emotion because no verified VA evaluator is available",
  "audio_components": [
    "motion",
    "cut",
    "tonal",
    "novelty",
    "consistency"
  ],
  "undefined_correlation": "zero",
  "symbolic_weights": {
    "beat": 0.3,
    "phrase": 0.25,
    "key": 0.2,
    "diversity": 0.15,
    "playability": 0.1
  },
  "weights": {
    "mode": "rule",
    "temperature": 1.0,
    "rho": 0.1,
    "floor": 0.0001,
    "max_step": 0.1,
    "update_every": 8,
    "consistency_final_gain": 1.5,
    "on_error": "error"
  },
  "measurements": {
    "analysis_hz": 100.0,
    "summary_hz": 2.0,
    "max_lag_seconds": 0.1,
    "boundary_tolerance_seconds": 0.1,
    "phrase_silence_seconds": 0.25,
    "onset_coefficient": 0.5,
    "envelope_coefficient": 0.5
  }
}
